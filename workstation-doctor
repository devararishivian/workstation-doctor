#!/usr/bin/env bash
# workstation-doctor — audit CLI untuk Pi / Herdr / Ghostty / MCP / skills.
# Stack: Bash + python3 (stdlib saja). Tanpa dependensi baru, tanpa GUI.
# Mode:  ./workstation-doctor            -> menu interaktif
#        ./workstation-doctor --check    -> 1. pengecekan read-only
#        ./workstation-doctor --manual   -> 2. langkah manual berurutan
#        ./workstation-doctor --fix      -> 3. perbaikan otomatis (konfirmasi)
# Exit: 0 = semua OK, 1 = ada yang perlu diupdate, 2 = ada cek UNKNOWN/gagal.
set -u

PI_NPM_DIR="$HOME/.pi/agent/npm"
SUPERPOWERS_DIR="$HOME/.pi/agent/git/github.com/obra/superpowers"
AGENTS_SKILLS_DIR="$HOME/.agents/skills"
PI_SETTINGS="$HOME/.pi/agent/settings.json"
PI_MCP="$HOME/.pi/agent/mcp.json"
PI_MCP_CACHE="$HOME/.pi/agent/mcp-cache.json"
GHOSTTY_BIN="/Applications/Ghostty.app/Contents/MacOS/ghostty"

N_OK=0; N_UPDATE=0; N_UNKNOWN=0
MANUAL_STEPS=()
FIX_CMDS=()

have() { command -v "$1" >/dev/null 2>&1; }

row() { # $1=komponen $2=terpasang $3=terbaru $4=status $5=catatan
  printf '%-22s %-16s %-16s %-10s %s\n' "$1" "$2" "$3" "$4" "$5"
}

mark_ok()     { N_OK=$((N_OK + 1)); row "$1" "$2" "$3" "OK" "$4"; }
mark_update() { # $1 komp $2 installed $3 latest $4 manual-step $5 fix-cmd $6 note
  N_UPDATE=$((N_UPDATE + 1)); row "$1" "$2" "$3" "UPDATE" "$6"
  MANUAL_STEPS+=("$4"); FIX_CMDS+=("$5")
}
mark_unknown() { N_UNKNOWN=$((N_UNKNOWN + 1)); row "$1" "$2" "$3" "UNKNOWN" "$4"; }

header() {
  printf '\n%-22s %-16s %-16s %-10s %s\n' "KOMPONEN" "TERPASANG" "TERBARU" "STATUS" "CATATAN"
  printf '%s\n' "----------------------------------------------------------------------------------------------"
}

npm_latest() { # $1=package -> version atau ""
  have npm || return 0
  npm view "$1" version 2>/dev/null | tr -d ' \r\n'
}

npm_global_installed() { # $1=package -> version atau ""
  have npm || return 0
  npm list -g --depth=0 --json 2>/dev/null | python3 -c "
import json,sys
try:
  d = json.load(sys.stdin)
  print(d.get('dependencies', {}).get('$1', {}).get('version', ''))
except Exception:
  print('')
" 2>/dev/null
}

check_npm_pkg() { # $1=label $2=npm-package
  local label="$1" pkg="$2" inst latest
  inst="$(npm_global_installed "$pkg")"
  [ -z "$inst" ] && { mark_unknown "$label" "-" "-" "paket npm global tidak ditemukan / npm error"; return; }
  latest="$(npm_latest "$pkg")"
  [ -z "$latest" ] && { mark_unknown "$label" "$inst" "-" "gagal baca versi terbaru (offline?)"; return; }
  if [ "$inst" = "$latest" ]; then
    mark_ok "$label" "$inst" "$latest" "npm global"
  else
    mark_update "$label" "$inst" "$latest" \
      "npm i -g ${pkg}@${latest}" \
      "npm i -g ${pkg}@${latest}" \
      "npm global tertinggal"
  fi
}

check_pi() {
  local inst latest
  have pi || { mark_unknown "pi" "-" "-" "binary pi tidak ada di PATH"; return; }
  inst="$(pi --version 2>/dev/null | tr -d ' \r\n')"
  latest="$(npm_latest "@earendil-works/pi-coding-agent")"
  [ -z "$inst" ] && { mark_unknown "pi" "-" "-" "gagal baca pi --version"; return; }
  [ -z "$latest" ] && { mark_unknown "pi" "$inst" "-" "gagal baca npm registry (offline?)"; return; }
  if [ "$inst" = "$latest" ]; then mark_ok "pi" "$inst" "$latest" "npm"
  else mark_update "pi" "$inst" "$latest" \
    "npm i -g @earendil-works/pi-coding-agent@${latest}" \
    "npm i -g @earendil-works/pi-coding-agent@${latest}" \
    "npm tertinggal"; fi
}

check_herdr() {
  local inst latest
  have herdr || { mark_unknown "herdr" "-" "-" "binary herdr tidak ada di PATH"; return; }
  inst="$(herdr --version 2>/dev/null | awk '{print $2}')"
  latest="$(brew info --json=v2 herdr 2>/dev/null | python3 -c "
import json,sys
try:
  d = json.load(sys.stdin); f = d['formulae'][0]
  print(f.get('versions', {}).get('stable', ''))
except Exception:
  print('')
" 2>/dev/null)"
  [ -z "$inst" ] && { mark_unknown "herdr" "-" "-" "gagal baca herdr --version"; return; }
  [ -z "$latest" ] && { mark_unknown "herdr" "$inst" "-" "gagal baca brew info (offline?)"; return; }
  if [ "$inst" = "$latest" ]; then mark_ok "herdr" "$inst" "$latest" "brew"
  else mark_update "herdr" "$inst" "$latest" \
    "brew upgrade herdr" \
    "brew upgrade herdr" \
    "brew tertinggal"; fi
}

check_ghostty() {
  local inst latest
  [ -x "$GHOSTTY_BIN" ] || { mark_unknown "ghostty" "-" "-" "Ghostty.app tidak ditemukan"; return; }
  inst="$("$GHOSTTY_BIN" --version 2>/dev/null | head -n1 | awk '{print $NF}')"
  latest="$(brew info --cask --json=v2 ghostty 2>/dev/null | python3 -c "
import json,sys
try:
  d = json.load(sys.stdin); print(d['casks'][0].get('version', ''))
except Exception:
  print('')
" 2>/dev/null)"
  [ -z "$inst" ] && { mark_unknown "ghostty" "-" "-" "gagal baca ghostty --version"; return; }
  [ -z "$latest" ] && { mark_unknown "ghostty" "$inst" "-" "gagal baca brew cask info (offline?)"; return; }
  # versi cask bisa "1.3.1,xyz" -> bandingkan segmen pertama
  latest="${latest%%,*}"
  if [ "$inst" = "$latest" ]; then mark_ok "ghostty" "$inst" "$latest" "brew cask"
  else mark_update "ghostty" "$inst" "$latest" \
    "brew upgrade --cask ghostty" \
    "brew upgrade --cask ghostty" \
    "cask tertinggal"; fi
}

check_serena() {
  local inst latest
  have serena || { mark_unknown "serena" "-" "-" "binary serena tidak ada di PATH"; return; }
  inst="$(serena --version 2>/dev/null | awk '{print $2}')"
  latest="$(python3 -c "
import json,urllib.request
try:
  r = urllib.request.urlopen('https://pypi.org/pypi/serena-agent/json', timeout=10)
  print(json.loads(r.read())['info']['version'])
except Exception:
  print('')
" 2>/dev/null)"
  [ -z "$inst" ] && { mark_unknown "serena" "-" "-" "gagal baca serena --version"; return; }
  [ -z "$latest" ] && { mark_unknown "serena" "$inst" "-" "gagal baca PyPI (offline?)"; return; }
  if [ "$inst" = "$latest" ]; then mark_ok "serena" "$inst" "$latest" "uv tool + PyPI"
  else mark_update "serena" "$inst" "$latest" \
    "uv tool upgrade serena-agent" \
    "uv tool upgrade serena-agent" \
    "uv tool tertinggal"; fi
}

check_gortex() {
  local inst out
  have gortex || { mark_unknown "gortex" "-" "-" "binary gortex tidak ada di PATH"; return; }
  inst="$(gortex version 2>/dev/null | head -n1 | awk '{print $2}')"
  out="$(gortex upgrade 2>&1)"
  [ -z "$inst" ] && { mark_unknown "gortex" "-" "-" "gagal baca gortex version"; return; }
  if printf '%s' "$out" | grep -qi "already the latest"; then
    mark_ok "gortex" "$inst" "$inst" "self-update: latest"
  else
    mark_update "gortex" "$inst" "latest?" \
      "gortex upgrade --run" \
      "gortex upgrade --run" \
      "update tersedia (cek: gortex upgrade)"
  fi
}

check_brew_outdated() {
  have brew || { mark_unknown "brew-outdated" "-" "-" "brew tidak ada"; return; }
  local list
  list="$(brew outdated 2>/dev/null)"
  if [ -z "$list" ]; then
    mark_ok "brew-outdated" "0" "0" "semua formula/cask terkini"
  else
    local n
    n="$(printf '%s' "$list" | grep -c .)"
    mark_update "brew-outdated" "${n} paket" "-" \
      "brew upgrade # tertinggal: $(printf '%s' "$list" | tr '\n' ' ')" \
      "brew upgrade" \
      "tertanggal: $(printf '%s' "$list" | tr '\n' ' ')"
  fi
}

check_npm_outdated_global() {
  have npm || { mark_unknown "npm-outdated-g" "-" "-" "npm tidak ada"; return; }
  local list
  list="$(npm outdated -g --json 2>/dev/null | python3 -c "
import json,sys
try:
  d = json.load(sys.stdin); print(' '.join(sorted(d.keys())))
except Exception:
  print('')
" 2>/dev/null)"
  if [ -z "$list" ]; then
    mark_ok "npm-outdated-g" "0" "0" "semua paket global terkini"
  else
    mark_update "npm-outdated-g" "$list" "-" \
      "npm update -g # tertinggal: $list" \
      "npm update -g" \
      "paket global tertinggal"
  fi
}

check_pi_npm() {
  [ -d "$PI_NPM_DIR" ] || { mark_unknown "pi-packages" "-" "-" "$PI_NPM_DIR tidak ada"; return; }
  local list
  list="$( (cd "$PI_NPM_DIR" && npm outdated --json 2>/dev/null) | python3 -c "
import json,sys
try:
  d = json.load(sys.stdin); print(' '.join(sorted(d.keys())))
except Exception:
  print('')
" 2>/dev/null)"
  if [ -z "$list" ]; then
    mark_ok "pi-packages" "0" "0" "~/.pi/agent/npm terkini"
  else
    mark_update "pi-packages" "$list" "-" \
      "cd ~/.pi/agent/npm && npm update # tertinggal: $list" \
      "npm update --prefix \"$PI_NPM_DIR\"" \
      "extension Pi tertinggal"
  fi
}

check_superpowers() {
  [ -d "$SUPERPOWERS_DIR/.git" ] || { mark_unknown "superpowers" "-" "-" "repo tidak ditemukan"; return; }
  local local_head remote_head status
  local_head="$(git -C "$SUPERPOWERS_DIR" rev-parse HEAD 2>/dev/null)"
  remote_head="$(git -C "$SUPERPOWERS_DIR" ls-remote origin main 2>/dev/null | awk '{print $1}')"
  status="$(git -C "$SUPERPOWERS_DIR" status -uno --porcelain=v1 2>/dev/null | head -n3 | tr '\n' ';')"
  [ -z "$local_head" ] && { mark_unknown "superpowers" "-" "-" "gagal baca git HEAD"; return; }
  if [ -z "$remote_head" ]; then
    mark_unknown "superpowers" "${local_head:0:7}" "-" "gagal hubungi origin (offline?)"
    return
  fi
  if [ "$local_head" = "$remote_head" ]; then
    mark_ok "superpowers" "${local_head:0:7}" "${remote_head:0:7}" "main sinkron origin${status:+; kerja kotor: $status}"
  else
    mark_update "superpowers" "${local_head:0:7}" "${remote_head:0:7}" \
      "git -C ~/.pi/agent/git/github.com/obra/superpowers pull --ff-only" \
      "git -C \"$SUPERPOWERS_DIR\" pull --ff-only" \
      "main tertinggal dari origin"
  fi
}

check_herdr_integrations() {
  have herdr || { mark_unknown "herdr-integr" "-" "-" "herdr tidak ada"; return; }
  local st pi_line oc_line
  st="$(herdr integration status 2>/dev/null)"
  [ -z "$st" ] && { mark_unknown "herdr-integr" "-" "-" "gagal baca integration status"; return; }
  pi_line="$(printf '%s' "$st" | grep -E '^pi:')"
  oc_line="$(printf '%s' "$st" | grep -E '^opencode:')"
  local need_fix="" need_manual=""
  case "$pi_line" in *current*) ;; *) need_fix="pi"; need_manual="herdr integration install pi ## ($pi_line)";; esac
  case "$oc_line" in *current*) ;; *)
    [ -n "$need_fix" ] && need_fix="$need_fix opencode" || need_fix="opencode"
    need_manual="$need_manual; herdr integration install opencode ## ($oc_line)"
  esac
  if [ -z "$need_fix" ]; then
    mark_ok "herdr-integr" "pi,opencode" "current" "hook status agen sinkron"
  else
    mark_update "herdr-integr" "stale" "current" \
      "herdr integration install $need_fix ## detail: $need_manual" \
      "herdr integration install $need_fix" \
      "hook ketinggalan: $need_fix"
  fi
}

check_ghostty_config() {
  [ -x "$GHOSTTY_BIN" ] || { mark_unknown "ghostty-config" "-" "-" "Ghostty.app tidak ada"; return; }
  if "$GHOSTTY_BIN" +show-config --changes-only >/dev/null 2>&1; then
    mark_ok "ghostty-config" "valid" "valid" "config terparse"
  else
    mark_unknown "ghostty-config" "invalid?" "valid" "config gagal divalidasi, cek manual"
  fi
}

check_pi_config() {
  local ok=1 note=""
  for f in "$PI_SETTINGS" "$PI_MCP"; do
    [ -f "$f" ] || { ok=0; note="$note $(basename "$f") hilang;"; continue; }
    python3 -c "import json; json.load(open('$f'))" 2>/dev/null || { ok=0; note="$note $(basename "$f") JSON rusak;"; }
  done
  [ -f "$PI_MCP_CACHE" ] || { ok=0; note="$note mcp-cache.json hilang;"; }
  if [ "$ok" = "1" ]; then
    local servers
    servers="$(python3 -c "import json; print(len(json.load(open('$PI_MCP')).get('mcpServers', {})))" 2>/dev/null)"
    mark_ok "pi-config" "valid" "valid" "${servers:-?} MCP server, cache ada"
  else
    mark_unknown "pi-config" "cek" "-" "masalah config:$note"
  fi
}

check_skills() {
  [ -d "$AGENTS_SKILLS_DIR" ] || { mark_unknown "skills" "-" "-" "$AGENTS_SKILLS_DIR tidak ada"; return; }
  local res
  res="$(python3 - "$AGENTS_SKILLS_DIR" <<'EOF' 2>/dev/null
import os, re, sys
root = sys.argv[1]
bad, total = [], 0
for dp, dn, fn in os.walk(root):
    if 'SKILL.md' in fn:
        total += 1
        p = os.path.join(dp, 'SKILL.md')
        try:
            head = open(p, encoding='utf-8', errors='replace').read(6000)
        except Exception:
            continue
        m = re.search(r'^description:\s*(.+?)\s*$', head, re.M | re.S)
        if not m:
            continue
        desc = m.group(1).strip().strip('"').strip("'")
        desc = re.sub(r'\s+', ' ', desc)
        if len(desc) > 1024:
            bad.append(os.path.relpath(p, root))
print(f"{total}|{len(bad)}|{','.join(bad[:5])}")
EOF
)"
  [ -z "$res" ] && { mark_unknown "skills" "-" "-" "gagal audit SKILL.md"; return; }
  local total="${res%%|*}"; local rest="${res#*|}"; local badn="${rest%%|*}"
  if [ "$badn" = "0" ]; then
    mark_ok "skills" "$total skill" "100%<=1024" "batas agentskills.io lolos"
  else
    mark_unknown "skills" "$total skill" "-" "$badn deskripsi >1024 char: ${rest#*|}"
  fi
}

run_checks() {
  N_OK=0; N_UPDATE=0; N_UNKNOWN=0; MANUAL_STEPS=(); FIX_CMDS=()
  header
  check_pi
  check_herdr
  check_ghostty
  check_npm_pkg "opencode" "opencode-ai"
  check_npm_pkg "tokenjuice" "tokenjuice"
  check_serena
  check_gortex
  check_brew_outdated
  check_npm_outdated_global
  check_pi_npm
  check_superpowers
  check_herdr_integrations
  check_ghostty_config
  check_pi_config
  check_skills
  printf '\nRingkasan: %d OK · %d perlu update · %d unknown\n' "$N_OK" "$N_UPDATE" "$N_UNKNOWN"
}

print_manual() {
  printf '\n== Langkah manual berurutan ==\n'
  if [ "${#MANUAL_STEPS[@]}" -eq 0 ]; then
    printf 'Tidak ada tindakan. Semua komponen terkini.\n'
    return
  fi
  local i=1 s
  for s in "${MANUAL_STEPS[@]}"; do printf '%d. %s\n' "$i" "$s"; i=$((i + 1)); done
}

run_fix() {
  local auto_yes="${1:-0}"
  printf '\n== Perbaikan otomatis ==\n'
  if [ "${#FIX_CMDS[@]}" -eq 0 ]; then
    printf 'Tidak ada tindakan. Semua komponen terkini.\n'
    return 0
  fi
  local i=1 c
  for c in "${FIX_CMDS[@]}"; do printf '%d. %s\n' "$i" "$c"; i=$((i + 1)); done
  if [ "$auto_yes" != "1" ]; then
    printf '\nJalankan %d perintah di atas berurutan? [y/N] ' "${#FIX_CMDS[@]}"
    read -r ans || ans=""
    case "$ans" in y|Y|yes|YES) ;; *) printf 'Dibatalkan.\n'; return 0;; esac
  fi
  local fail=0
  for c in "${FIX_CMDS[@]}"; do
    printf '\n$ %s\n' "$c"
    if eval "$c"; then printf 'OK: %s\n' "$c"
    else printf 'GAGAL (lanjut): %s\n' "$c"; fail=$((fail + 1)); fi
  done
  printf '\nSelesai. Gagal: %d dari %d.\n' "$fail" "${#FIX_CMDS[@]}"
  [ "$fail" -gt 0 ] && return 1 || return 0
}

usage() {
  sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'
  printf '\nPakai: %s [--check|--manual|--fix [--yes]|--help]\n' "$(basename "$0")"
}

menu() {
  while true; do
    printf '\nworkstation-doctor\n'
    printf '  1. Cek status (read-only)\n'
    printf '  2. Tampilkan langkah manual berurutan\n'
    printf '  3. Jalankan perbaikan otomatis\n'
    printf '  0. Keluar\n'
    printf 'Pilih [0-3]: '
    read -r ch || ch=""
    case "$ch" in
      1) run_checks;;
      2) run_checks; print_manual;;
      3) run_checks; run_fix 0;;
      0|q|quit|exit) break;;
      *) printf 'Pilihan tidak dikenal.\n';;
    esac
  done
}

main() {
  case "${1:-}" in
    --check)  run_checks; [ "$N_UPDATE" -gt 0 ] && exit 1 || { [ "$N_UNKNOWN" -gt 0 ] && exit 2 || exit 0; };;
    --manual) run_checks; print_manual; [ "$N_UPDATE" -gt 0 ] && exit 1 || exit 0;;
    --fix)    shift; run_checks; [ "${1:-}" = "--yes" ] && run_fix 1 || run_fix 0;;
    --help|-h) usage;;
    "") menu;;
    *) printf 'Argumen tidak dikenal: %s\n' "$1"; usage; exit 2;;
  esac
}

main "$@"
